<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.chatapp.client.controller.MainController"
           prefHeight="600.0" prefWidth="900.0">

    <!-- Left Side - User Profile and Controls -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <VBox.margin>
                <Insets />
            </VBox.margin>

            <!-- User Profile Section -->
            <VBox spacing="5" style="-fx-background-color: #34495e; -fx-padding: 15; -fx-background-radius: 5;">
                <Label fx:id="userNameLabel" text="User Name" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" />
                <Label fx:id="userStatusLabel" text="ONLINE" style="-fx-text-fill: #2ecc71; -fx-font-size: 12;" />

                <HBox spacing="5" alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets top="10" />
                    </VBox.margin>
                    <Label text="Status:" style="-fx-text-fill: white;" />
                    <ComboBox fx:id="statusComboBox" prefWidth="120" />
                </HBox>
            </VBox>

            <!-- Search Section -->
            <VBox spacing="5">
                <VBox.margin>
                    <Insets top="10" />
                </VBox.margin>
                <Label text="Search Users:" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                <HBox spacing="5">
                    <TextField fx:id="searchField" promptText="Search..." HBox.hgrow="ALWAYS" />
                    <Button fx:id="searchButton" text="Search" onAction="#handleSearch" />
                </HBox>
            </VBox>

            <!-- Actions -->
            <VBox spacing="10">
                <VBox.margin>
                    <Insets top="20" />
                </VBox.margin>
                <Button text="Create Group" onAction="#handleCreateGroup" maxWidth="Infinity"
                       style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" maxWidth="Infinity"
                       style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- Center - Friend List and Groups -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <!-- Friends Tab -->
            <Tab text="Friends">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="Friends List" style="-fx-font-size: 18; -fx-font-weight: bold;" />
                    <Separator />
                    <ListView fx:id="friendListView" VBox.vgrow="ALWAYS" />
                    <Label text="Double-click to chat" style="-fx-font-size: 11; -fx-text-fill: gray;" />
                </VBox>
            </Tab>

            <!-- Groups Tab -->
            <Tab text="Groups">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="My Groups" style="-fx-font-size: 18; -fx-font-weight: bold;" />
                    <Separator />
                    <ListView fx:id="groupListView" VBox.vgrow="ALWAYS" />
                    <Label text="Double-click to open group chat" style="-fx-font-size: 11; -fx-text-fill: gray;" />
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
